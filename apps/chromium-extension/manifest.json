{
  "manifest_version": 3,
  "name": "Copy Repair 复制修复",
  "version": "0.1.0",
  "description": "在网页字体混淆与复制事件篡改时，还原出与可见文字一致的复制内容。全部本地运行，不上传任何内容。",
  "key": "",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "111"
}
