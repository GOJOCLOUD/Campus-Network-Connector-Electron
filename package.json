{
  "name": "xyw",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "electron:build": "npm run build && npm run build:win-native && cross-env ELECTRON_RUN_AS_NODE= electron .",
    "build:win-native": "node-gyp rebuild --directory=win-input",
    "build:vendor": "node tools/build-vendor.mjs",
    "build:extension": "node tools/build.mjs chromium",
    "dist:win": "npm run build && npm run build:win-native && electron-builder --win --x64 --publish never",
    "pretest": "npm run build",
    "test": "node tools/verify/verify-ui-platforms.cjs",
    "verify:package": "node tools/verify/verify-package-win.cjs"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "electron": "^41.0.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.5.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.8",
    "puppeteer": "^25.14.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "build": {
    "appId": "com.gojocloud.campus-network-connector",
    "productName": "模拟输入",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "backend/**/*",
      "win-input/**/*.node",
      "win-input/index.js",
      "src/features/index.js",
      "src/features/chromium-repair/**/*",
      "package.json",
      "playback-guard.cjs",
      "shortcut-latch.cjs"
    ],
    "afterPack": "electron/after-pack.cjs",
    "extraResources": [
      {
        "from": "build/win-icon.ico",
        "to": "win-icon.ico"
      },
      {
        "from": "dist-core/chromium",
        "to": "browser-extension"
      }
    ],
    "win": {
      "icon": "build/win-icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "CampusNetworkConnector-win-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "unicode": true,
      "installerIcon": "build/win-icon.ico",
      "shortcutName": "模拟输入"
    },
    "asarUnpack": [
      "win-input/**"
    ],
    "electronLanguages": [
      "zh_CN",
      "en"
    ]
  }
}
