{
  "name": "xyw",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "build:native": "mkdir -p mac-coregraphics/build/Release && clang++ -std=c++17 -fexceptions -ObjC++ -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk -I node_modules/node-addon-api -I /opt/homebrew/include/node -framework CoreGraphics -framework Carbon -framework Foundation -undefined dynamic_lookup -dynamiclib -o mac-coregraphics/build/Release/mac-coregraphics.node mac-coregraphics/src/main.mm",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:build": "npm run build && npm run build:native && npm run build:vendor && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist:mac:arm64": "npm run build && npm run build:native && npm run build:vendor && npx electron-builder --mac dir --arm64 --publish never",
    "dist:mac": "npm run build && npm run build:native && npm run build:vendor && npx electron-builder --mac dir --publish never",
    "test": "node --test --test-concurrency=1 src/features/safari-repair/test/*.cjs",
    "build:vendor": "node tools/build-vendor.mjs",
    "build:reference-db": "CR_INCLUDE_GBK=1 node tools/build-reference-db.mjs --size 48 --out tools/reference-fonts/glyph-db-48-gbk.crdb",
    "build:core": "node tools/build.mjs",
    "test:core": "node --test packages/core/test/*.test.ts",
    "test:e2e": "node --test tests/e2e/*.test.ts"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "node-addon-api": "^8.3.1",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.8",
    "puppeteer": "^25.14.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "build": {
    "appId": "com.gojocloud.campus-network-connector",
    "productName": "模拟输入",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "backend/**/*",
      "mac-coregraphics/**/*.node",
      "mac-coregraphics/index.js",
      "package.json",
      "vendor/**/*",
      "src/features/**/*",
      "!src/features/**/test/**/*",
      "!docs/**/*",
      "!tools/**/*",
      "!packages/**/*",
      "!apps/**/*",
      "!tests/**/*",
      "!**/*.md"
    ],
    "afterPack": "electron/after-pack.cjs",
    "mac": {
      "icon": "build/app-icon.png",
      "target": [
        "dir"
      ],
      "identity": null,
      "artifactName": "CampusNetworkConnector-mac-${version}.${ext}"
    },
    "asarUnpack": [
      "mac-coregraphics/**"
    ],
    "electronLanguages": [
      "zh_CN",
      "en"
    ]
  }
}
